#!/bin/bash

# psf analytical profile 
prof=1

ALLPHOT_EXE=%BUILDDIR%/bin/allphot
ALLPHOT_DATA_PATH=%BUILDDIR%
ALLPHOT_LIBEXEC_PATH=%BUILDDIR%
ALLPHOT_DEFAULT_MODULES_PATH=%SRCDIR%/modules
ALLPHOT_OPTDIR=%SRCDIR%/data
ALLPHOT_TESTDIR=%SRCDIR%/tests

export ALLPHOT_DATA_PATH ALLPHOT_LIBEXEC_PATH 
export ALLPHOT_DEFAULT_MODULES_PATH ALLPHOT_OPTDIR
export PATH=%BUILDDIR%/src:${PATH}

for fits in ${ALLPHOT_TESTDIR}/sky??.fits; do
    im=$(basename ${fits%.*})
    ${ALLPHOT_EXE} daophot opt \
	--option GA=$(fitskey -n -p GAIN ${fits}) \
	--option RE=$(fitskey -n -p RON ${fits}) \
	--option HI=$(fitskey -n -p SATLEV ${fits})
    ${ALLPHOT_EXE} daophot find ${fits} --output=${ALLPHOT_TESTDIR}/results/${im}.coo
    ${ALLPHOT_EXE} daophot phot ${fits} --output=${ALLPHOT_TESTDIR}/results/${im}.ap
    ${ALLPHOT_EXE} daophot pick ${ALLPHOT_TESTDIR}/results/${im}.ap --output=${ALLPHOT_TESTDIR}/results/${im}.lst
    ${ALLPHOT_EXE} daophot psf ${fits} --photfile=${ALLPHOT_TESTDIR}/results/${im}.ap --psfstars=${ALLPHOT_TESTDIR}/results/${im}.lst --output=${ALLPHOT_TESTDIR}/results/${im}.psf
    ${ALLPHOT_EXE} cat neighbours ${ALLPHOT_TESTDIR}/results/${im}.psf.nei ${ALLPHOT_TESTDIR}/results/${im}.lst
    ${ALLPHOT_EXE} daophot psf --option AN=-${prof} ${fits} --photfile=${ALLPHOT_TESTDIR}/results/${im}.ap --psfstars=${ALLPHOT_TESTDIR}/results/${im}.lst --output=${ALLPHOT_TESTDIR}/results/${im}.psf
    ${ALLPHOT_EXE} cat neighbours ${ALLPHOT_TESTDIR}/results/${im}.psf.nei ${ALLPHOT_TESTDIR}/results/${im}.lst
    ${ALLPHOT_EXE} daophot psf --option AN=-${prof} ${fits} --photfile=${ALLPHOT_TESTDIR}/results/${im}.ap --psfstars=${ALLPHOT_TESTDIR}/results/${im}.lst --output=${ALLPHOT_TESTDIR}/results/${im}.psf
    ${ALLPHOT_EXE} allstar ${fits} --output=${ALLPHOT_TESTDIR}/results/${im}.als
done

${ALLPHOT_EXE} daomatch --output=${ALLPHOT_TESTDIR}/results/sky.mch ${ALLPHOT_TESTDIR}/results/sky??.als
${ALLPHOT_EXE} daomaster ${ALLPHOT_TESTDIR}/results/sky.mch
${ALLPHOT_EXE} allframe ${ALLPHOT_TESTDIR}/results/sky.mch
${ALLPHOT_EXE} montage2 ${ALLPHOT_TESTDIR}/results/sky.mch

unset ALLPHOT_DATA_PATH ALLPHOT_LIBEXEC_PATH 
unset ALLPHOT_DEFAULT_MODULES_PATH ALLPHOT_OPTDIR
